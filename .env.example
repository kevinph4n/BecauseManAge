# Lấy ở Supabase Dashboard → Project Settings → API (hoặc nút "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Dùng 1 trong 2: publishable key (sb_publishable_...) HOẶC anon key (eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL của site (dùng cho link xác nhận email). Local: http://localhost:3000 — Vercel: https://<app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
